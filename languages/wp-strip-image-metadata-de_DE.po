msgid "Strip Image Metadata"
msgstr "Strip Image Metadata"

#. Description of the plugin
#: strip-image-metadata.php
msgid "Strip image metadata from JPGs and WEBPs on upload or via bulk action, and view image EXIF data."
msgstr "Bild-Metadaten aus JPGs und WEBPs beim Hochladen oder per Massenaktion entfernen und anzeigen."

#: classes/StripImageMetadata.php:293
msgid "Save settings"
msgstr "Einstellungen speichern"

#: classes/StripImageMetadata.php:297
msgid "Plugin Information"
msgstr "Plugin Informationen"

#: classes/StripImageMetadata.php:319
#: classes/StripImageMetadata.php:599
msgid "WP Strip Image Metadata: compatible image processing library not found. This plugin requires the \"Imagick\" or \"Gmagick\" PHP extension to function - please ask your webhost or system administrator if either can be enabled."
msgstr "WP Strip Image Metadata: kompatible Bildverarbeitungsbibliothek nicht gefunden. Dieses Plugin benötigt die PHP-Erweiterung \"Imagick\" oder \"Gmagick\", um zu funktionieren - bitte fragen Sie Ihren Webhost oder Systemadministrator, ob eines von beiden aktiviert werden kann."

#: classes/StripImageMetadata.php:323
msgid "Copyright Information of available Files"
msgstr "Copyright Information in verfügbaren Dateien"

#: classes/StripImageMetadata.php:324
msgid "- in copyright.jpg"
msgstr "- in copyright.jpg"

#: classes/StripImageMetadata.php:331
#: classes/StripImageMetadata.php:351
msgid "File copyright.jpg not found"
msgstr "Datei copyright.jpg nicht gefunden"

#: classes/StripImageMetadata.php:344
msgid "- in copyright.webp"
msgstr "- in copyright.webp"

#: classes/StripImageMetadata.php:402
msgid "Plugin Settings"
msgstr "Plugin Einstellungen"

#: classes/StripImageMetadata.php:409
msgid "Image Metadata Stripping"
msgstr "Bild-Metadaten entfernen"

#: classes/StripImageMetadata.php:418
msgid "Preserve ICC Color Profile"
msgstr "ICC Farbprofil behalten"

#: classes/StripImageMetadata.php:427
msgid "Preserve Image Orientation"
msgstr "Bildausrichtung behalten"

#: classes/StripImageMetadata.php:436
msgid "Set Size Limit"
msgstr "Größenbeschränkung setzen"

#: classes/StripImageMetadata.php:445
msgid "Set / Keep Copyright"
msgstr "Copyright setzen / erhalten"

#: classes/StripImageMetadata.php:454
msgid "Log Errors"
msgstr "Fehlermeldungen speichern"

#: classes/StripImageMetadata.php:562
msgid "Enabled"
msgstr "Aktiviert"

#: classes/StripImageMetadata.php:564
msgid "Disabled"
msgstr "Deaktiviert"

#: classes/StripImageMetadata.php:578
msgid "Set the Maximum Width of Image for Stripping Metadata. 0 means stripping no image at all. 10000 means stripping all images"
msgstr "Maximale Bildbreite für das Entfernen der Metadaten setzen. \"0\" bedeutet : Nichts wird entfernt. \"10000\" bedeutet: Metadaten in allen Bildern werden entfernt"

#: classes/StripImageMetadata.php:618
msgid "WP Strip Image Metadata: stripping is currently disabled."
msgstr "WP Strip Image Metadata: Das Entfernen ist derzeit deaktiviert."

#: classes/StripImageMetadata.php:697
#: classes/StripImageMetadata.php:753
msgid "Meta Size"
msgstr "Metadaten"

#: classes/StripImageMetadata.php:697
msgid " and filesize"
msgstr " und Dateigröße"

#: classes/StripImageMetadata.php:697
msgid " of "
msgstr " für "

#: classes/StripImageMetadata.php:784
msgid "WP Strip Image Metadata: expand for image EXIF data. Length : "
msgstr "WP Strip Image Metadata: Erweitern für EXIF-Daten. Länge : "

#: classes/StripImageMetadata.php:875
#, php-format
msgid "WP Strip Image Metadata: %s image including"
msgid_plural "WP Strip Image Metadata: %s images including"
msgstr[0] "Metadaten entfernen: %s Bild einschließlich"
msgstr[1] "Metadaten entfernen: %s Bilder einschließlich"

#: classes/StripImageMetadata.php:882
msgid "subsizes was stripped"
msgid_plural "subsizes were stripped"
msgstr[0] "skalierter Dateien wurde bearbeitet"
msgstr[1] "skalierter Dateien wurden bearbeitet"

#: classes/StripImageMetadata.php:903
msgid "WP Strip Image Metadata: unable to locate all image paths. This might be due to a non-standard WordPress uploads directory location."
msgstr "WP Strip Image Metadata: Es können nicht alle Bildpfade gefunden werden. Dies könnte auf einen nicht standardmäßigen WordPress-Uploads-Verzeichnisstandort zurückzuführen sein."

