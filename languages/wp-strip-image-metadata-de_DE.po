#: classes/StripImageMetadata.php:770
msgid "Stripped"
msgstr "Entfernt"

#: classes/StripImageMetadata.php:787
msgid "Strip Metadata"
msgstr "Entferne Metadaten"

#: classes/StripImageMetadata.php:138
msgid "You are not allowed to strip image metadata."
msgstr "Sie sind nicht berechtigt, Bild-Metadaten zu entfernen."

#: classes/StripImageMetadata.php:152
msgid "You are not allowed to modify this attachment."
msgstr "Sie sind nicht berechtigt, diesen Anhang zu ändern."

#: classes/StripImageMetadata.php:178
msgid "The supplied ID is not an image attachment."
msgstr "Die angegebene ID gehört nicht zu einem Bildanhang."

#: classes/StripImageMetadata.php:191
msgid "No image files were found for this attachment."
msgstr "Für diesen Anhang wurden keine Bilddateien gefunden."

#: classes/StripImageMetadata.php:236
msgid "The image metadata was stripped successfully including all subsizes."
msgstr "Die Bild-Metadaten wurden einschließlich aller skalierten Bildgrößen erfolgreich entfernt."

#: classes/StripImageMetadata.php:240
msgid "Metadata could not be stripped from all image files."
msgstr "Die Metadaten konnten nicht aus allen Bilddateien entfernt werden."

#. translators: %s is the image processing library name and version active on the site
#: classes/StripImageMetadata.php:303
#, php-format
msgid "Compatible image processing library active: %s. PHP-Library is: %s"
msgstr "Kompatible Bildverarbeitungsbibliothek aktiv: %s. Die PHP-Bibliothek ist: %s"

#: classes/StripImageMetadata.php:314
msgid "Supported image formats: "
msgstr "Unterstützte Bildformate: "

#: classes/StripImageMetadata.php:364
msgid "- in copyright.avif"
msgstr "- in copyright.avif"

#: classes/StripImageMetadata.php:371
msgid "File copyright.avif not found"
msgstr "Datei copyright.avif nicht gefunden"

#: classes/StripImageMetadata.php:672
#: classes/StripImageMetadata.php:709
msgid "No ICC Profile found"
msgstr "Kein ICC-Profil gefunden"

#: classes/StripImageMetadata.php:747
#: classes/StripImageMetadata.php:764
msgid "The EXIF data could not be formatted."
msgstr "Die EXIF-Daten konnten nicht formatiert werden."

#: classes/StripImageMetadata.php:750
msgid "All Exif-Data are the same."
msgstr "EXIF-Daten sind in allen Bildern identisch."

#: classes/StripImageMetadata.php:794
msgid "File Paths with Metadata in Bytes"
msgstr "Dateipfade mit Metadaten in Byte"

#: classes/StripImageMetadata.php:807
msgid "Size of extracted Metadata from the original, unscaled image (additional metadata may be present)"
msgstr "Größe der aus dem ursprünglichen, unskalierten Bild extrahierten Metadaten (weitere Metadaten können vorhanden sein)"

#: classes/StripImageMetadata.php:830
msgid "Stripped Metadata (smallest image)"
msgstr "Entfernte Metadaten (kleinstes Bild)"
